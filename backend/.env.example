# Copie este arquivo para .env e preencha os valores reais.
# O .env NÃO vai para o git (ver .gitignore).

# Banco usado DENTRO do container docker-compose:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/carcinutri

# Banco usado RODANDO FORA do Docker (ex.: alembic no host):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/carcinutri

# Chave secreta para assinar os JWT. Use um valor longo e aleatório em produção.
JWT_SECRET=troque-esta-chave-em-producao

# Algoritmo e expiração do token (30 dias — sessão longa para app offline).
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Origens permitidas no CORS (dev: *). Flutter web usa porta aleatória.
CORS_ORIGINS=*
